#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""elm-purifier: locks the packages an Elm project downloads, so that Nix
can build the project offline in its sandbox.

    elm-purifier lock [--lockfile PATH] [--main FILE]... [--tests | --no-tests]
        Runs the Elm compiler (and elm-test, when the project has tests)
        with an empty ELM_HOME, records every package they download, and
        writes elm-purifier.lock.json beside elm.json. Without --main, an
        application keeps the entry modules its current lockfile records,
        or, without a lockfile, every module that defines `main`. Without
        --tests or --no-tests, the lock keeps its current setting, or
        covers the tests when tests/ holds an Elm module.
    elm-purifier update [--lockfile PATH] [PACKAGE]...
        Moves the project to newer package versions, then locks it. For an
        application, elm-json moves the versions in elm.json: every package
        within its major version, or the named direct dependencies. For a
        package, whose elm.json gives ranges, it locks the newest versions
        the ranges admit, where `lock` keeps the versions its current
        lockfile records.
    elm-purifier prefetch [--lockfile PATH]
        Builds the locked packages and the tools with Nix, keeps them
        alive with a garbage-collector root beside the lockfile
        (.elm-purifier.lock.json.gcroot for the default lockfile), and
        links the tools into elm-stuff/elm-purifier/bin: elm, elm-test,
        elm-format and elm-language-server. With that directory first on
        PATH, the compiler, the tests and the editor run on the locked
        packages with no network.
    elm-purifier publish [--lockfile PATH] [--check]
        Builds the package's release with Nix, checks that the
        documentation the compiler writes is the one Nix built, and runs
        `elm publish` on the locked packages. --check stops before
        `elm publish`.

--lockfile reads and writes the lockfile at PATH instead of beside
elm.json, for a lockfile kept outside the project. Without --lockfile,
the environment variable ELM_PURIFIER_LOCKFILE names it, as a dev shell
can set it. prefetch records the lockfile, so the tools in
elm-stuff/elm-purifier/bin read the same one unless ELM_PURIFIER_LOCKFILE
names another.

The wrapper sets ELM_PURIFIER_TOOLCHAINS (a JSON object from compiler
version to its `elm`, its `elm-test` executables by the major version of
elm-explorations/test they run, and the arguments that keep elm-test
offline; see nix/lib/toolchains.nix), ELM_PURIFIER_ELM_FORMAT and
ELM_PURIFIER_ELM_LANGUAGE_SERVER (the editor tools), ELM_PURIFIER_ELM_JSON
(the tool that `update` moves versions with), ELM_PURIFIER_LIB
(the Nix library), ELM_PURIFIER_NIXPKGS (the nixpkgs that library builds
with), ELM_PURIFIER_PURIFIER (the shared purifier library pinned in the
flake.lock of elm-purifier) and ELM_PURIFIER_CLI (the store path of this
command). The tools in elm-stuff/elm-purifier/bin run this script with
ELM_PURIFIER_TOOL, the name of the tool, and ELM_PURIFIER_TOOL_PATH, the
path they were run as.
"""

import base64
import hashlib
import fcntl
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.request

LOCK_NAME = "elm-purifier.lock.json"
PACKAGE_SERVER = "https://package.elm-lang.org"
STATE_DIR = os.path.join("elm-stuff", "elm-purifier")
LOCK_FIELDS = ("contentHash", "elmJson", "tests", "hashes")


def fail(message):
    print(f"elm-purifier: {message}", file=sys.stderr)
    sys.exit(1)


def note(message):
    print(f"elm-purifier: {message}", file=sys.stderr)


def lock_version():
    path = os.path.join(os.environ["ELM_PURIFIER_LIB"], "lock-version.nix")
    with open(path) as f:
        lines = [line for line in f if not line.lstrip().startswith("#")]
    return int("".join(lines).strip())


def toolchains():
    return json.loads(os.environ["ELM_PURIFIER_TOOLCHAINS"])


def version_key(version):
    return tuple(int(part) for part in version.split("."))


def satisfies(version, constraint):
    """Whether a version satisfies an elm.json constraint, such as
    "0.19.0 <= v < 0.20.0", or equals an exact version."""
    match = re.fullmatch(r"\s*(\S+)\s*(<=|<)\s*v\s*(<=|<)\s*(\S+)\s*", constraint)
    if not match:
        return version == constraint.strip()
    low, low_op, high_op, high = match.groups()
    v = version_key(version)
    low_ok = v >= version_key(low) if low_op == "<=" else v > version_key(low)
    high_ok = v <= version_key(high) if high_op == "<=" else v < version_key(high)
    return low_ok and high_ok


def select_compiler(elm_json):
    """The compiler a project builds with: the exact version an
    application names, or the newest version a package's range admits."""
    available = sorted(toolchains(), key=version_key, reverse=True)
    wanted = elm_json["elm-version"]
    for version in available:
        if satisfies(version, wanted):
            return version
    fail(
        f'elm.json asks for Elm "{wanted}", and this elm-purifier provides '
        f"{', '.join(available)}."
    )


def sri_sha256(data):
    return "sha256-" + base64.b64encode(hashlib.sha256(data).digest()).decode()


def file_sri(path):
    with open(path, "rb") as f:
        return sri_sha256(f.read())


def content_hash(lock_data):
    """The hash a lockfile records as contentHash: the SHA-256 of the lock
    without that field, in the JSON that Nix's builtins.toJSON writes
    (keys sorted, no whitespace). nix/lib/lock-hash.nix computes the same."""
    rest = {key: value for key, value in lock_data.items() if key != "contentHash"}
    text = json.dumps(rest, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return sri_sha256(text.encode())


def read_json(path):
    with open(path) as f:
        return json.load(f)


LOCK_HINT = "run `elm-purifier lock` (with --lockfile when the lockfile is kept outside the project) to write it again"


def read_lock(path):
    """The lockfile at `path`, checked as nix/lib/lock.nix checks it, or a
    message that names the command that writes it again."""
    try:
        data = read_json(path)
    except json.JSONDecodeError as error:
        fail(f"{path} is not valid JSON ({error}); {LOCK_HINT}.")
    if not isinstance(data, dict) or "version" not in data:
        fail(f"{path} is not an elm-purifier lockfile; {LOCK_HINT}.")
    if data["version"] != lock_version():
        fail(
            f"{path} has lock format version {data['version']}, and this elm-purifier "
            f"reads version {lock_version()}; {LOCK_HINT}."
        )
    for field in LOCK_FIELDS:
        if field not in data:
            fail(f"{path} has no field `{field}`; {LOCK_HINT}.")
    if data["contentHash"] != content_hash(data):
        fail(
            f"{path} was edited after `elm-purifier lock` wrote it, because its "
            f"contentHash does not match its content; {LOCK_HINT}."
        )
    return data


def find_project():
    project = os.getcwd()
    if not os.path.exists(os.path.join(project, "elm.json")):
        fail("run elm-purifier in the directory that holds elm.json.")
    return project


def lock_path(project, given):
    """The lockfile a command reads and writes: --lockfile, else
    ELM_PURIFIER_LOCKFILE, else the one beside elm.json."""
    given = given or os.environ.get("ELM_PURIFIER_LOCKFILE")
    return os.path.abspath(given) if given else os.path.join(project, LOCK_NAME)


def gc_root(path):
    """The garbage-collector root that prefetch makes for a lockfile: a
    hidden link beside it, named after it."""
    directory, name = os.path.split(path)
    return os.path.join(directory, f".{name}.gcroot")


MODULE_RE = re.compile(r"^(?:port\s+|effect\s+)?module\s+([A-Z][A-Za-z0-9_.]*)", re.M)
MAIN_RE = re.compile(r"^main\s*[:=]", re.M)


def module_name(path):
    with open(path, encoding="utf-8") as f:
        match = MODULE_RE.search(f.read())
    if not match:
        fail(f"{path} has no module declaration.")
    return match.group(1)


def find_mains(project, elm_json):
    """The modules under the source directories that define `main`."""
    mains = []
    for directory in elm_json["source-directories"]:
        root = os.path.normpath(os.path.join(project, directory))
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = sorted(d for d in dirnames if d != "elm-stuff")
            for filename in sorted(filenames):
                if not filename.endswith(".elm"):
                    continue
                path = os.path.join(dirpath, filename)
                with open(path, encoding="utf-8") as f:
                    if MAIN_RE.search(f.read()):
                        mains.append(os.path.relpath(path, project))
    return mains


def has_tests(project):
    """Whether tests/ holds an Elm module, which is where elm-test looks."""
    for _, _, filenames in os.walk(os.path.join(project, "tests")):
        if any(name.endswith(".elm") for name in filenames):
            return True
    return False


def http_get(url):
    request = urllib.request.Request(url, headers={"User-Agent": "elm-purifier"})
    with urllib.request.urlopen(request) as response:
        return response.read()


def installed_packages(home, compiler_version):
    """The author/project/version directories under a package cache."""
    root = os.path.join(home, compiler_version, "packages")
    found = []
    if not os.path.isdir(root):
        return found
    for author in sorted(os.listdir(root)):
        author_dir = os.path.join(root, author)
        if not os.path.isdir(author_dir):
            continue
        for project in sorted(os.listdir(author_dir)):
            for version in sorted(os.listdir(os.path.join(author_dir, project))):
                found.append(f"{author}/{project}/{version}")
    return found


class FreshElmStuff:
    """Moves the project's elm-stuff aside while the lock run uses a fresh
    one, and puts it back afterwards."""

    def __init__(self, project):
        self.path = os.path.join(project, "elm-stuff")
        self.saved = self.path + ".elm-purifier-saved"

    def __enter__(self):
        if os.path.exists(self.saved):
            fail(f"{self.saved} is left from an interrupted lock run; move it back to elm-stuff first.")
        if os.path.exists(self.path):
            os.rename(self.path, self.saved)
        return self

    def __exit__(self, *exc):
        shutil.rmtree(self.path, ignore_errors=True)
        if os.path.exists(self.saved):
            os.rename(self.saved, self.path)
        return False


def test_major(elm_json):
    """The major version of elm-explorations/test the tests use: the exact
    version an application names, or the lower bound of the range a
    package names. None without elm-explorations/test. nix/lib/test-major.nix
    applies the same rule."""
    tests = elm_json.get("test-dependencies", {})
    if elm_json["type"] == "application":
        tests = {**tests.get("direct", {}), **tests.get("indirect", {})}
    version = tests.get("elm-explorations/test")
    if version is None:
        return None
    return re.match(r"[^0-9]*([0-9]+)", version).group(1)


def elm_test(toolchain, elm_json):
    """The toolchain's elm-test for the elm-explorations/test the project
    uses."""
    major = test_major(elm_json)
    if major is None:
        fail("the tests need elm-explorations/test in the test-dependencies of elm.json.")
    if major not in toolchain["elm-test"]:
        fail(f"this elm-purifier has no elm-test for elm-explorations/test {major}.x with this compiler.")
    return toolchain["elm-test"][major]


def elm_test_command(toolchain, elm_json, offline):
    """The elm-test for the project with the toolchain's compiler. elm-test
    solves the test dependencies itself, from Node; on a locked package
    cache it runs with the arguments that keep it from asking the package
    server."""
    command = [elm_test(toolchain, elm_json), "--compiler", toolchain["elm"]]
    return command + toolchain["elm-test-offline-args"] if offline else command


# The errors that the Elm compiler reports when its own threads collide
# while it writes the cache of a project's dependencies. The same compile
# succeeds when it runs again.
ELM_RACES = ("resource busy (file is locked)", "blocked indefinitely in an MVar operation")
ELM_ATTEMPTS = 4


def run_elm_tool(command, project, env):
    """Runs a tool of the lock run, and runs it again with a fresh
    elm-stuff when it fails with one of ELM_RACES. Its output goes to the
    terminal as it arrives."""
    for attempt in range(1, ELM_ATTEMPTS + 1):
        proc = subprocess.Popen(
            command, cwd=project, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, errors="replace",
        )
        output = []
        with proc.stdout:
            for line in proc.stdout:
                sys.stderr.write(line)
                output.append(line)
        status = proc.wait()
        if status == 0:
            return
        if attempt < ELM_ATTEMPTS and any(race in "".join(output) for race in ELM_RACES):
            note(f"{os.path.basename(command[0])} failed on a race inside the Elm compiler; running it again")
            shutil.rmtree(os.path.join(project, "elm-stuff"), ignore_errors=True)
            continue
        raise subprocess.CalledProcessError(status, command)


def locked_environment(environment):
    """Keep native package solvers on the prepared registry and package cache.

    Elm has no offline make flag: a failed registry request selects its cached
    registry. Scope this proxy setting to locked commands, leaving capture,
    update and native publication able to contact their upstream services.
    """
    env = dict(environment)
    for key in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"):
        env[key] = "http://127.0.0.1:9"
    env["NO_PROXY"] = env["no_proxy"] = ""
    env["NODE_USE_ENV_PROXY"] = "1"
    return env


def run_tools(project, elm_json, toolchain, mains, tests, home, offline):
    """Runs what the Nix build runs, with ELM_HOME at `home`: the compiler
    on every entry module (or on the package's documentation), and
    elm-test on the tests. Node uses a proxy from the environment only with
    NODE_USE_ENV_PROXY, which makes elm-test reach the network the way the
    compiler does."""
    env = dict(os.environ, ELM_HOME=home, NODE_USE_ENV_PROXY="1")
    if offline:
        env = locked_environment(env)
    elm = toolchain["elm"]
    with FreshElmStuff(project):
        if elm_json["type"] == "application":
            if mains:
                run_elm_tool([elm, "make", *mains, "--output=/dev/null"], project, env)
        else:
            docs = os.path.join(home, "docs.json")
            run_elm_tool([elm, "make", f"--docs={docs}"], project, env)
        if tests:
            command = elm_test_command(toolchain, elm_json, offline)
            run_elm_tool([command[0], "make", *command[1:]], project, env)


def archive_url(package):
    """The URL of a package's zip: the zipball of its tag on GitHub, which
    is what the package server names. nix/lib/lock.nix builds the same
    URL."""
    author, project, version = package.split("/")
    return f"https://github.com/{author}/{project}/zipball/{version}/"


def record(package):
    """The SHA-256 of an author/project/version's zip, after checking it
    against the hash the package server gives and checking that the server
    names the URL the build derives."""
    endpoint = json.loads(http_get(f"{PACKAGE_SERVER}/packages/{package}/endpoint.json"))
    if endpoint["url"] != archive_url(package):
        fail(
            f"the package server names {endpoint['url']} for {package}, and elm-purifier "
            f"builds from {archive_url(package)}, so it cannot lock this package."
        )
    archive = http_get(endpoint["url"])
    if hashlib.sha1(archive).hexdigest() != endpoint["hash"]:
        fail(f"the archive of {package} at {endpoint['url']} does not match the package server's hash.")
    return sri_sha256(archive)


def named_packages(elm_json, tests):
    """The packages an application's elm.json names, as author/project/
    version: its dependencies, and its test dependencies when the lock
    covers the tests. nix/lib/lock.nix reads the same."""
    sections = [elm_json["dependencies"]]
    if tests:
        sections.append(elm_json["test-dependencies"])
    return sorted(
        f"{name}/{version}"
        for section in sections
        for kind in ("direct", "indirect")
        for name, version in section[kind].items()
    )


def compiler_version(data, elm_json):
    """The compiler version of a lock: the one an application's elm.json
    names, or the one a package's lock records."""
    return elm_json["elm-version"] if elm_json["type"] == "application" else data["elmVersion"]


def nix_build(file, args, out_link=None):
    """Builds one of the Nix library's entry files outside a flake, with
    the nixpkgs and the shared purifier library the command was built
    with, and returns the result of nix-build."""
    command = [
        "nix-build",
        os.path.join(os.environ["ELM_PURIFIER_LIB"], file),
        "--arg",
        "nixpkgs",
        os.environ["ELM_PURIFIER_NIXPKGS"],
        "--arg",
        "purifierSrc",
        os.environ["ELM_PURIFIER_PURIFIER"],
        *args,
    ]
    command += ["--out-link", out_link] if out_link else ["--no-out-link"]
    return subprocess.run(command, stdout=subprocess.PIPE, text=True)


def nix_lock_args(path, project):
    """The arguments that name a lockfile and its elm.json to the Nix
    library."""
    return ["--arg", "lockFile", path, "--arg", "elmJsonFile", os.path.join(project, "elm.json")]


def built_path(result, message):
    if result.returncode != 0:
        fail(f"{message} (its error is above).")
    return result.stdout.strip().splitlines()[-1]


def realize(path, project):
    """Builds the package cache of a lockfile for the elm.json of a
    project with Nix and returns its store path."""
    return built_path(
        nix_build("realize.nix", nix_lock_args(path, project)),
        f"Nix could not build the package cache of {path}. A hash mismatch means an "
        "archive changed on the server since the lock was made; run `elm-purifier lock` "
        "to write the lockfile again",
    )


def writable_copy(source, destination):
    shutil.rmtree(destination, ignore_errors=True)
    shutil.copytree(source, destination, symlinks=False)
    for dirpath, dirnames, filenames in os.walk(destination):
        os.chmod(dirpath, os.stat(dirpath).st_mode | stat.S_IWUSR)
        for name in filenames:
            path = os.path.join(dirpath, name)
            os.chmod(path, os.stat(path).st_mode | stat.S_IWUSR)


def previous_lock(path):
    """The current lockfile at `path`, for the settings a new lock keeps,
    or None when there is none or it does not parse."""
    if not os.path.exists(path):
        return None
    try:
        data = read_json(path)
    except json.JSONDecodeError:
        note(f"{path} does not parse, so the lock run starts from elm.json alone.")
        return None
    return data if isinstance(data, dict) else None


def keeps_resolution(previous, elm_json_path):
    """Whether a package's current lockfile is valid for its elm.json, so
    that a new lock keeps the versions it records."""
    return (
        previous is not None
        and previous.get("version") == lock_version()
        and previous.get("contentHash") == content_hash(previous)
        and previous.get("elmJson") == file_sri(elm_json_path)
        and "solved" in previous
        and "hashes" in previous
    )


def lock(path, mains, tests, resolve=False):
    """Locks the project. An application's elm.json names every version,
    so the lock follows it. A package's elm.json gives ranges: when its
    current lockfile is valid for elm.json, the lock run starts from that
    lockfile's package cache, where the solver finds the versions it
    records, unless `resolve` asks for the newest versions in the ranges."""
    project = find_project()
    elm_json_path = os.path.join(project, "elm.json")
    elm_json = read_json(elm_json_path)
    compiler_version = select_compiler(elm_json)
    toolchain = toolchains()[compiler_version]
    previous = previous_lock(path)
    is_application = elm_json["type"] == "application"
    seeded = not is_application and not resolve and keeps_resolution(previous, elm_json_path)
    if seeded:
        compiler_version = previous["elmVersion"]
        toolchain = toolchains()[compiler_version]
    if is_application and not mains:
        recorded = (previous or {}).get("applications", {})
        mains = sorted(recorded.values()) or find_mains(project, elm_json)
        if not mains:
            fail("found no module that defines `main`; name the entry modules with --main.")
    if elm_json["type"] == "package" and mains:
        fail("--main applies to applications; a package's output is its documentation.")
    if tests is None:
        tests = previous["tests"] if previous and "tests" in previous else has_tests(project)

    work = tempfile.mkdtemp(prefix="elm-purifier-lock-")
    try:
        home = os.path.join(work, "home")
        if seeded:
            note(f"running Elm {compiler_version} on the packages {path} records, which it keeps")
            writable_copy(realize(path, project), home)
        else:
            note(f"running Elm {compiler_version} with an empty ELM_HOME")
        run_tools(project, elm_json, toolchain, mains, tests, home, offline=seeded)
        packages = installed_packages(home, compiler_version)
        named = named_packages(elm_json, tests) if is_application else packages
        if set(packages) != set(named):
            unnamed = sorted(set(packages) - set(named))
            unused = sorted(set(named) - set(packages))
            fail(
                "the packages the compiler and elm-test downloaded differ from the ones "
                f"elm.json names. Downloaded but not named: {', '.join(unnamed) or 'none'}. "
                f"Named but not downloaded: {', '.join(unused) or 'none'}. The build fetches "
                "the packages elm.json names, so run `elm install` for each package the "
                "project needs."
            )
        note(f"recording {len(packages)} packages")
        hashes = {package.rsplit("/", 1)[0]: record(package) for package in packages}

        lock_data = {
            "version": lock_version(),
            "elmJson": file_sri(elm_json_path),
            "tests": tests,
            "hashes": hashes,
        }
        if is_application:
            lock_data["applications"] = {
                module_name(os.path.join(project, main)): main for main in mains
            }
        else:
            lock_data["elmVersion"] = compiler_version
            lock_data["solved"] = dict(package.rsplit("/", 1) for package in packages)
        lock_data["contentHash"] = content_hash(lock_data)
        candidate = os.path.join(work, LOCK_NAME)
        with open(candidate, "w") as f:
            json.dump(lock_data, f, indent=2, sort_keys=True)
            f.write("\n")

        # The check: the same tools on the cache Nix builds from the
        # lockfile download nothing more.
        note("checking the lockfile against a package cache built by Nix")
        offline = os.path.join(work, "offline-home")
        writable_copy(realize(candidate, project), offline)
        run_tools(project, elm_json, toolchain, mains, tests, offline, offline=True)
        extra = sorted(set(installed_packages(offline, compiler_version)) - set(packages))
        if extra:
            fail(f"the second run downloaded packages the first did not: {', '.join(extra)}")
        shutil.copyfile(candidate, path)
        note(f"wrote {path}; run `elm-purifier prefetch` to work on the locked packages")
    finally:
        shutil.rmtree(work, ignore_errors=True)


ELM_VERSION_RE = re.compile(r'("elm-version"\s*:\s*")([^"]+)(")')


def update(path, names):
    """Moves the project to newer package versions, then locks it. An
    application's elm.json pins every version, and elm-json moves them:
    `elm-json upgrade` for every package, within its major version, or
    `elm-json install` for the named ones. elm-json knows Elm 0.19.0 and
    0.19.1, and the package ranges admit every 0.19 compiler, so for
    another compiler it solves a copy of elm.json that names 0.19.1. A
    package's elm.json gives ranges, so the lock run solves them again."""
    project = find_project()
    elm_json_path = os.path.join(project, "elm.json")
    elm_json = read_json(elm_json_path)
    if elm_json["type"] == "package":
        if names:
            fail(
                "a package's elm.json gives version ranges, and its lock holds the newest "
                "versions in them; run `elm-purifier update` without package names."
            )
        lock(path, [], None, resolve=True)
        return

    tests = elm_json["test-dependencies"]
    commands = []
    if names:
        direct = [name for name in names if name in elm_json["dependencies"]["direct"]]
        test = [name for name in names if name in tests["direct"]]
        other = [name for name in names if name not in direct and name not in test]
        if other:
            fail(
                f"elm.json has no direct dependency {', '.join(other)}; elm-json updates "
                "the indirect ones with the direct dependencies that need them."
            )
        if direct:
            commands.append(["install", "--yes", *direct])
        if test:
            commands.append(["install", "--yes", "--test", *test])
    else:
        commands.append(["upgrade", "--yes"])

    with open(elm_json_path) as f:
        text = f.read()
    version = ELM_VERSION_RE.search(text).group(2)
    work = tempfile.mkdtemp(prefix="elm-purifier-update-")
    try:
        copy = os.path.join(work, "elm.json")
        with open(copy, "w") as f:
            f.write(ELM_VERSION_RE.sub(r"\g<1>0.19.1\g<3>", text, count=1))
        for command in commands:
            if command[0] == "install":
                command += ["--", copy]
            else:
                command.append(copy)
            # elm-json caches the package index in the user's cache
            # directory; the update uses one of its own, so that it neither
            # reuses a stale index nor needs a writable home.
            env = dict(os.environ, HOME=work, XDG_CACHE_HOME=os.path.join(work, "cache"))
            status = subprocess.run(
                [os.environ["ELM_PURIFIER_ELM_JSON"], *command], env=env
            ).returncode
            if status != 0:
                fail(f"elm-json {command[0]} failed (its error is above); elm.json is unchanged.")
        with open(copy) as f:
            updated = ELM_VERSION_RE.sub(lambda m: m.group(1) + version + m.group(3), f.read(), count=1)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    with open(elm_json_path, "w") as f:
        f.write(updated)
    lock(path, [], None)


def checked_lock(project, path):
    """The lockfile at `path`, which must match the project's elm.json."""
    if not os.path.exists(path):
        fail(f"there is no lockfile at {path}; run `elm-purifier lock`.")
    data = read_lock(path)
    if data["elmJson"] != file_sri(os.path.join(project, "elm.json")):
        fail(
            f"elm.json changed since {path} was made, so the project may need packages the "
            "lock does not record; run `elm-purifier lock`, then `elm-purifier prefetch`."
        )
    is_application = read_json(os.path.join(project, "elm.json"))["type"] == "application"
    for field in ("applications",) if is_application else ("elmVersion", "solved"):
        if field not in data:
            fail(f"{path} has no field `{field}`; {LOCK_HINT}.")
    return data


def state(project, name):
    return os.path.join(project, STATE_DIR, name)


def install_home(project, root):
    """Reuse compiled artifacts only for this exact prepared cache and SDK."""
    realized = os.path.realpath(os.path.join(root, "home"))
    home = state(project, "home")
    parent = os.path.dirname(home)
    os.makedirs(parent, exist_ok=True)
    identity = json.dumps({"schema": 1, "root": os.path.realpath(root), "home": realized}, sort_keys=True)
    # Compilation and LSP startup can both request the first writable home.
    with open(state(project, "home.lock"), "a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        backup = home + ".previous"
        if os.path.exists(backup):
            if not os.path.exists(home):
                os.replace(backup, home)
            else:
                shutil.rmtree(backup)
        marker = os.path.join(home, ".source")
        if os.path.exists(marker):
            with open(marker) as f:
                if f.read() == identity:
                    return home
        staged = tempfile.mkdtemp(prefix=".home-", dir=parent)
        try:
            writable_copy(realized, staged)
            with open(os.path.join(staged, ".source"), "w") as f:
                f.write(identity)
            # Keep the previous home until the complete replacement is ready;
            # recover it if installation fails or a prior process was stopped.
            if os.path.exists(home):
                os.replace(home, backup)
            try:
                os.replace(staged, home)
            except BaseException:
                if os.path.exists(backup):
                    os.replace(backup, home)
                raise
            shutil.rmtree(backup, ignore_errors=True)
        finally:
            shutil.rmtree(staged, ignore_errors=True)
    return home


def prefetch(path):
    project = find_project()
    data = checked_lock(project, path)
    os.makedirs(state(project, ""), exist_ok=True)
    root = gc_root(path)
    built_path(
        nix_build(
            "prefetch.nix",
            [*nix_lock_args(path, project), "--argstr", "cli", os.environ["ELM_PURIFIER_CLI"]],
            out_link=root,
        ),
        f"Nix could not build the packages of {path}",
    )
    install_home(project, root)
    bin_link = state(project, "bin")
    if os.path.lexists(bin_link):
        os.remove(bin_link)
    os.symlink(os.path.join(root, "bin"), bin_link)
    with open(state(project, "lockfile"), "w") as f:
        f.write(path)
    version = compiler_version(data, read_json(os.path.join(project, "elm.json")))
    note(
        f"prefetched {len(data['hashes'])} packages and the Elm {version} tools. "
        f"Put {os.path.join(STATE_DIR, 'bin')} first on PATH to run elm, elm-test, elm-format "
        "and elm-language-server on them."
    )


def store_root(executable):
    """The store path of a toolchain executable, /nix/store/…/bin/x."""
    return os.path.dirname(os.path.dirname(executable))


def publish(path, check_only):
    """Publishes a package with `elm publish`, on the locked packages,
    after checking that the documentation it uploads is the one in the
    release Nix builds. Elm publishes by registering a pushed git tag with
    the package server, so the files themselves come from that tag."""
    project = find_project()
    if read_json(os.path.join(project, "elm.json"))["type"] != "package":
        fail("publish applies to packages; an application is not published.")
    data = checked_lock(project, path)
    toolchain = toolchains()[compiler_version(data, read_json(os.path.join(project, "elm.json")))]
    release = built_path(
        nix_build(
            "project.nix",
            [
                "-A",
                "release",
                "--argstr",
                "projectDir",
                project,
                "--arg",
                "lockFile",
                path,
                "--argstr",
                "elm",
                store_root(toolchain["elm"]),
            ],
        ),
        "Nix could not build the release",
    )

    work = tempfile.mkdtemp(prefix="elm-purifier-publish-")
    try:
        home = os.path.join(work, "home")
        writable_copy(realize(path, project), home)
        docs = os.path.join(work, "docs.json")
        subprocess.run(
            [toolchain["elm"], "make", f"--docs={docs}"],
            cwd=project,
            env=locked_environment(dict(os.environ, ELM_HOME=home)),
            check=True,
        )
        with open(docs, "rb") as f, open(os.path.join(release, "docs.json"), "rb") as g:
            if f.read() != g.read():
                fail(f"the documentation `elm make --docs` writes differs from {release}/docs.json.")
        note(f"the documentation matches the release Nix built at {release}")
        if not check_only:
            status = subprocess.run(
                [toolchain["elm"], "publish"], cwd=project, env=dict(os.environ, ELM_HOME=home)
            ).returncode
            sys.exit(status)
    finally:
        shutil.rmtree(work, ignore_errors=True)


# The tools that prefetch links into elm-stuff/elm-purifier/bin.

# The compiler commands that change elm.json or talk to the package server
# by design. They run with the usual ELM_HOME, where the compiler can
# download.
ONLINE_ELM = ("init", "install", "bump", "diff")
# The elm-test commands that add elm-explorations/test to elm.json.
ONLINE_ELM_TEST = ("init", "install")


def tool_project(invoked):
    """The project a tool runs for: the one whose elm-stuff/elm-purifier/bin
    the tool was run from, or else the nearest directory at or above the
    working directory that holds elm.json. None when there is neither."""
    marker = os.sep + os.path.join(STATE_DIR, "bin") + os.sep
    if marker in invoked:
        return invoked[: invoked.index(marker)]
    directory = os.getcwd()
    while True:
        if os.path.exists(os.path.join(directory, "elm.json")):
            return directory
        parent = os.path.dirname(directory)
        if parent == directory:
            return None
        directory = parent


def prefetched(project):
    """The lockfile of a project and its prefetched ELM_HOME, or a message
    that names the command to run."""
    recorded = state(project, "lockfile")
    if os.environ.get("ELM_PURIFIER_LOCKFILE") or not os.path.exists(recorded):
        path = lock_path(project, None)
    else:
        path = open(recorded).read()
    data = checked_lock(project, path)
    root = gc_root(path)
    hash_file = os.path.join(root, "lock-hash")
    if not os.path.exists(hash_file) or open(hash_file).read().strip() != data["contentHash"]:
        fail(f"the packages of {path} are not prefetched; run `elm-purifier prefetch`.")
    return data, install_home(project, root)


def online(args, tool):
    status = subprocess.run([tool, *args]).returncode
    if status == 0 and args[0] in ("init", "install"):
        note("elm.json may have changed; run `elm-purifier lock`, then `elm-purifier prefetch`.")
    sys.exit(status)


def run_tool(name, invoked, args):
    if name == "elm-format":
        command = [os.environ["ELM_PURIFIER_ELM_FORMAT"], *args]
        os.execv(command[0], command)
    project = tool_project(invoked)
    elm_json = read_json(os.path.join(project, "elm.json")) if project else None
    recorded = state(project, "lockfile") if project else None
    path = lock_path(project, None) if project else None
    if project and not os.environ.get("ELM_PURIFIER_LOCKFILE") and os.path.exists(recorded):
        path = open(recorded).read()
    if path is None or not os.path.exists(path):
        note('warning: no elm-purifier.lock.json found; running Elm impurely. Run `elm-purifier lock` to use Nix-resolved dependencies.')
        version = select_compiler(elm_json) if elm_json else max(toolchains(), key=version_key)
        toolchain = toolchains()[version]
        if name == "elm":
            command = [toolchain["elm"], *args]
        elif name == "elm-test":
            test = elm_test(toolchain, elm_json) if elm_json else next(iter(toolchain["elm-test"].values()))
            command = [test, *args]
        else:
            command = [os.environ["ELM_PURIFIER_ELM_LANGUAGE_SERVER"], *args]
        os.execv(command[0], command)
    if name == "elm" and args[:1] == ["publish"]:
        fail("run `elm-purifier publish`, which checks the release Nix built before it publishes.")
    if name == "elm" and args[:1] and args[0] in ONLINE_ELM:
        online(args, toolchains()[select_compiler(elm_json)]["elm"])
    if name == "elm-test" and args[:1] and args[0] in ONLINE_ELM_TEST:
        toolchain = toolchains()[select_compiler(elm_json)]
        online(args, elm_test(toolchain, elm_json))
    data, home = prefetched(project)
    toolchain = toolchains()[compiler_version(data, elm_json)]
    env = {
        key: value
        for key, value in os.environ.items()
        if key not in ("ELM_PURIFIER_TOOL", "ELM_PURIFIER_TOOL_PATH")
    }
    env["ELM_HOME"] = home
    env = locked_environment(env)
    if name == "elm":
        command = [toolchain["elm"], *args]
    elif name == "elm-test":
        command = [*elm_test_command(toolchain, elm_json, offline=True), *args]
    elif name == "elm-language-server":
        # The server runs elm, elm-test and elm-format from PATH, which
        # puts the tools of this project first.
        env["PATH"] = os.pathsep.join([state(project, "bin"), env.get("PATH", "")])
        command = [os.environ["ELM_PURIFIER_ELM_LANGUAGE_SERVER"], *args]
    else:
        fail(f"there is no tool {name}.")
    os.execve(command[0], command, env)


def parse(verb, rest):
    """The options of a command: --lockfile for every command, and the
    options of `lock` and `publish`."""
    options = {"lockfile": None, "mains": [], "tests": None, "check": False, "names": []}
    args = iter(rest)
    for arg in args:
        if arg == "--lockfile":
            options["lockfile"] = next(args, None) or fail("--lockfile needs a path")
        elif verb == "update" and not arg.startswith("-"):
            options["names"].append(arg)
        elif verb == "lock" and arg == "--main":
            options["mains"].append(next(args, None) or fail("--main needs a file"))
        elif verb == "lock" and arg == "--tests":
            options["tests"] = True
        elif verb == "lock" and arg == "--no-tests":
            options["tests"] = False
        elif verb == "publish" and arg == "--check":
            options["check"] = True
        else:
            fail(f"{verb} does not take {arg}; see `elm-purifier --help`.")
    return options


def main(argv):
    tool = os.environ.get("ELM_PURIFIER_TOOL")
    if tool:
        run_tool(tool, os.environ.get("ELM_PURIFIER_TOOL_PATH", ""), argv)
        return
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return
    verb, rest = argv[0], argv[1:]
    if verb not in ("lock", "update", "prefetch", "publish"):
        fail(f"unknown command {verb}; see `elm-purifier --help`.")
    options = parse(verb, rest)
    if verb == "lock":
        lock(lock_path(os.getcwd(), options["lockfile"]), options["mains"], options["tests"])
    elif verb == "update":
        update(lock_path(os.getcwd(), options["lockfile"]), options["names"])
    elif verb == "prefetch":
        prefetch(lock_path(os.getcwd(), options["lockfile"]))
    else:
        publish(lock_path(os.getcwd(), options["lockfile"]), options["check"])


if __name__ == "__main__":
    main(sys.argv[1:])
